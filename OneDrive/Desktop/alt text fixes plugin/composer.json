{
    "name": "himalayan-autofixer/alt-text-fixer",
    "description": "Multi-purpose WordPress automation: alt text fixing everywhere + SEO meta/social/canonical, CSV import, theme audit, cron, WP-CLI.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Himalayan Auto-Fixer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "woocommerce/action-scheduler": "^3.8"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "files": [
            "alt-text-fixer.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -exec php -l {} \\;",
        "phpcs": "phpcs"
    }
}
